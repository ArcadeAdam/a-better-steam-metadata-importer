<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LaunchBoxRoot Condition="'$(LaunchBoxRoot)' == ''">$(LAUNCHBOX_ROOT)</LaunchBoxRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\SteamMetadataImporter\SteamMetadataImporter.csproj" />
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>$(LaunchBoxRoot)\Core\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateLaunchBoxRoot" BeforeTargets="ResolveReferences;ResolveAssemblyReferences">
    <Error Condition="'$(LaunchBoxRoot)' == ''" Text="Set LaunchBoxRoot to your LaunchBox installation with -p:LaunchBoxRoot=... or the LAUNCHBOX_ROOT environment variable." />
    <Error Condition="'$(LaunchBoxRoot)' != '' and !Exists('$(LaunchBoxRoot)\Core\Unbroken.LaunchBox.Plugins.dll')" Text="The LaunchBox plugin API was not found at $(LaunchBoxRoot)\Core\Unbroken.LaunchBox.Plugins.dll. Set LaunchBoxRoot to a matching LaunchBox installation." />
  </Target>
</Project>
